# ==========================================
# FOOTFALLS ANALYTICS - ENVIRONMENT FILE
# ==========================================
# IMPORTANT: DO NOT commit actual secrets to version control.
# Copy this file to .env and fill in the values.

# ------------------------------------------
# Server Configuration
# ------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS Configuration (Comma-separated for multiple origins)
# Set to exact domains in production (e.g., https://dashboard.footfalls.app)
CORS_ORIGINS=*

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Replace with your MongoDB Atlas Connection String or local Docker URI
# For local Docker Compose, use: mongodb://mongodb:27017
MONGO_URI=mongodb://mongodb:27017
DB_NAME=footfalls_db

# ------------------------------------------
# Firebase & Auth Configuration
# ------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
GOOGLE_CLIENT_ID=your-google-client-id

# JWT Secret for securing API endpoints and WebSockets
JWT_SECRET=super_secret_jwt_signature_key

# ------------------------------------------
# WebSocket & API URLs
# ------------------------------------------
# The frontend or mobile app expects these URLs for connection.
# Example: wss://api.footfalls.app/ws or ws://localhost:8000/ws
WS_URL=ws://localhost:8000/ws
API_BASE_URL=http://localhost:8000

# ------------------------------------------
# YOLO Model Configuration
# ------------------------------------------
# Path to the YOLOv8 model weights. 
# Ultralytics will auto-download yolov8n.pt if not found locally.
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
