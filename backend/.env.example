# ==========================================
# FOOTFALLS ANALYTICS - ENVIRONMENT FILE
# ==========================================

# Server Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS Configuration (Comma-separated for multiple)
# Set to exact domain in production (e.g., https://dashboard.footfalls.app)
CORS_ORIGINS=*

# MongoDB Configuration
# Replace with Atlas Connection String in Production
MONGO_URI=mongodb://localhost:27017
DB_NAME=footfalls_db

# Firebase Configuration
FIREBASE_PROJECT_ID=com-hemanthkodi-footfalls
FIREBASE_API_KEY=
GOOGLE_CLIENT_ID=
JWT_SECRET=super_secret_jwt_signature_key

# YOLO Model Configuration
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
